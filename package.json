{
  "name": "wealth-platform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "tsx server/index.ts",
    "api:test": "tsx server/test-server.ts",
    "dev:full": "concurrently --kill-others-on-fail -n api,web -c blue,green \"npm:api\" \"npm:dev\"",
    "db:up": "tsx server/db/up.ts",
    "db:wait": "tsx server/db/wait.ts",
    "db:setup": "tsx server/db/setup.ts",
    "db:down": "tsx server/db/down.ts",
    "db:reset": "npm run db:setup",
    "test:unit": "node --import tsx --test src/workspace/model.test.ts src/model/drift.test.ts",
    "test:server:unit": "node --import tsx --test --test-concurrency=1 server/workflows/validation.test.ts server/db/sql-script.test.ts",
    "test:int": "node --import tsx --test --test-concurrency=1 server/workflows/api.int.test.ts server/legacy.int.test.ts",
    "test:backend": "npm run test:server:unit && npm run test:int",
    "test:db": "tsx server/db/container-check.ts",
    "lint": "eslint .",
    "qa": "node qa/tooling/qa.mjs",
    "qa:test": "node --test qa/tooling/test/*.test.mjs",
    "typecheck:qa": "tsc -p tsconfig.qa.json",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p server",
    "visual-diff": "node scripts/visual-diff.mjs"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@types/express": "^4.17.25",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/parser": "8.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "eslint": "10.4.0",
    "globals": "16.5.0",
    "pixelmatch": "^6.0.0",
    "playwright-core": "1.48",
    "pngjs": "^7.0.0",
    "testcontainers": "^10.28.0",
    "tsx": "~4.19",
    "typescript": "5.6",
    "vite": "^5.4.21"
  }
}
